# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres) ---
DATABASE_URL=postgres://business_os:changeme@localhost:5432/business_os

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque random strings, not JWTs, so there's no
# corresponding JWT_REFRESH_SECRET to set — see src/lib/jwt.ts.
JWT_REFRESH_TTL_DAYS=7

# --- AI insights (server-side call to Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Accountant export links ---
ACCOUNTANT_LINK_TTL_HOURS=72
